<Page x:Class="GTAVNews.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="#1a1a2e">

    <Page.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#e63946"/>
        <SolidColorBrush x:Key="CardBrush" Color="#16213e"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#f1f1f1"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#a0a0b0"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0f0f1a" Padding="24,16">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Background="#e63946" CornerRadius="6" Width="6" Height="36"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="GTA V NEWS" FontSize="26" FontWeight="Bold"
                               Foreground="#f1f1f1" CharacterSpacing="150"/>
                    <TextBlock x:Name="SubtitleText" Text="Loading latest news..."
                               FontSize="12" Foreground="#a0a0b0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">

            <!-- Loading indicator -->
            <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="True" Width="60" Height="60" Foreground="#e63946"/>
                <TextBlock Text="Fetching GTA news..." FontSize="16" Foreground="#a0a0b0" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Error panel -->
            <StackPanel x:Name="ErrorPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="12" Visibility="Collapsed" MaxWidth="400">
                <TextBlock Text="⚠" FontSize="48" HorizontalAlignment="Center" Foreground="#e63946"/>
                <TextBlock x:Name="ErrorText" Text="Could not load news."
                           FontSize="16" Foreground="#f1f1f1" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center"/>
                <Button Content="Retry" Click="RetryButton_Click" HorizontalAlignment="Center"
                        Background="#e63946" Foreground="White" Padding="24,10" FontSize="14"/>
            </StackPanel>

            <!-- News list -->
            <ScrollViewer x:Name="NewsScrollViewer" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" Padding="24">
                <StackPanel x:Name="NewsPanel" Spacing="16"/>
            </ScrollViewer>

        </Grid>
    </Grid>
</Page>